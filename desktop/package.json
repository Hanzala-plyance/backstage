{
  "name": "backstage-desktop",
  "version": "0.2.0",
  "description": "Backstage rhythm desktop application",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:app": "node scripts/smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:dev": "node scripts/smoke-dev.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "midi-file": "1.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "usb": "2.19.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.7.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
